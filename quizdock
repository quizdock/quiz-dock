#!/bin/sh
# QuizDock operator CLI — install, run, upgrade, back up and administer a
# self-hosted instance. Needs only Docker (with the compose plugin). POSIX sh.
#
#   curl -fsSLO https://raw.githubusercontent.com/quizdock/quiz-dock/main/quizdock
#   chmod +x quizdock && ./quizdock init
#
# Deployment modes, chosen at `init` and remembered in `.env` (QUIZDOCK_MODE):
#   compose     docker-compose.prod.yml — app + PostgreSQL + Redis (production)
#   full        compose + bundled Keycloak (separate database)
#   standalone  one container (fchaussin/quizdock:standalone) — a first try, one machine
#
# Admin commands (doctor, seat:*, user:*, quiz:*, samples:load, sessions:purge)
# are relayed to the `qd` CLI shipped inside the image (/usr/local/bin/qd);
# quiz bundles cross the container boundary on stdin / stdout.
set -eu

IMAGE="${QUIZDOCK_IMAGE:-fchaussin/quizdock}"
# Where the deployment files come from: the repository at the release installed
# (QUIZDOCK_RAW, a full URL, overrides it — a mirror, a fork).
RAW_BASE="https://raw.githubusercontent.com/quizdock/quiz-dock"
COMPOSE_FILE="${QUIZDOCK_COMPOSE_FILE:-docker-compose.prod.yml}"
ENV_FILE="${QUIZDOCK_ENV_FILE:-.env}"
CONTAINER="${QUIZDOCK_CONTAINER:-quizdock}" # standalone container name
BACKUP_ROOT="${QUIZDOCK_BACKUP_DIR:-./backups}"

# --- helpers ---------------------------------------------------------------

say() { printf '%s\n' "$*"; }
info() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33mwarning:\033[0m %s\n' "$*" >&2; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null 2>&1 || die "docker is not installed (https://docs.docker.com/get-docker/)."
  docker info >/dev/null 2>&1 || die "cannot talk to the Docker daemon (is it running? are you in the docker group?)."
}

# Reads KEY from .env (last occurrence wins), or prints the default.
env_get() {
  key="$1"; default="${2-}"
  if [ -f "$ENV_FILE" ]; then
    val="$(grep -E "^${key}=" "$ENV_FILE" | tail -n1 | cut -d= -f2- || true)"
    [ -n "$val" ] && { printf '%s' "$val"; return; }
  fi
  printf '%s' "$default"
}

mode() { env_get QUIZDOCK_MODE compose; }
tag() { env_get QUIZDOCK_TAG latest; }
# The all-in-one image of that tag: `standalone` for latest, `standalone-X.Y.Z` for a release.
standalone_image() {
  case "$(tag)" in
    latest | standalone) printf '%s:standalone\n' "$IMAGE" ;;
    *) printf '%s:standalone-%s\n' "$IMAGE" "$(tag | sed 's/^standalone-//')" ;;
  esac
}
http_port() { env_get HTTP_PORT 18080; }

# The latest release's tag (vX.Y.Z), or nothing when GitHub cannot be asked.
latest_release() {
  curl -fsSL https://api.github.com/repos/quizdock/quiz-dock/releases/latest 2>/dev/null |
    sed -n 's/.*"tag_name": *"\(v[0-9][^"]*\)".*/\1/p' | head -n1
}

# The address of the deployment files for an image tag: the files of that release.
files_url() { # files_url <image tag>
  if [ -n "${QUIZDOCK_RAW:-}" ]; then printf '%s' "$QUIZDOCK_RAW"; return; fi
  case "$1" in
    latest | standalone) ref="$(latest_release)"; ref="${ref:-main}" ;;
    standalone-*) ref="v${1#standalone-}" ;;
    v*) ref="$1" ;;
    *) ref="v$1" ;;
  esac
  printf '%s/%s' "$RAW_BASE" "$ref"
}

# The deployment files of a mode, as `<path in the repository>:<local path>` pairs.
deployment_files() { # deployment_files <mode>
  case "$1" in
    compose) printf '%s\n' "docker-compose.prod.yml:$COMPOSE_FILE" ;;
    full)
      printf '%s\n' "docker-compose.prod.yml:$COMPOSE_FILE" "docker-compose.full.yml:docker-compose.full.yml" \
        "keycloak/realm-export.json:keycloak/realm-export.json"
      ;;
  esac
}

# Fetches one deployment file of a release. A copy of what was fetched stays in
# .quizdock/: a local file still equal to it was not edited, and is replaced; an
# edited one (or one from before these copies) is kept, the release's version
# written next to it as <file>.new, and the operator told. Never a silent rewrite.
fetch_file() { # fetch_file <base url> <repository path> <local path>
  url="$1/$2"; local_path="$3"; shipped=".quizdock/$2"
  tmp="$(mktemp)"
  if ! curl -fsSL "$url" -o "$tmp"; then rm -f "$tmp"; return 1; fi
  mkdir -p "$(dirname "$shipped")" "$(dirname "$local_path")"
  if [ ! -f "$local_path" ] || cmp -s "$local_path" "$tmp"; then
    cp "$tmp" "$local_path"
  elif [ -f "$shipped" ] && cmp -s "$local_path" "$shipped"; then
    cp "$tmp" "$local_path"
    info "updated $local_path"
  else
    cp "$tmp" "$local_path.new"
    warn "$local_path differs from what QuizDock shipped: the release's version is $local_path.new."
    warn "  compare: diff $local_path $local_path.new — then keep yours, or: mv $local_path.new $local_path"
  fi
  cp "$tmp" "$shipped"
  rm -f "$tmp"
}

# What `doctor` checks on this host, where the container cannot see: passwords of
# .env left to a default (or unset, so the Compose default applies). A warning,
# never a refusal: a first try may keep them; an instance in use should not.
check_secrets() {
  weak=""
  for key in POSTGRES_PASSWORD $([ "$(mode)" = full ] && printf '%s' 'KEYCLOAK_ADMIN_PASSWORD KEYCLOAK_HOST_PASSWORD KEYCLOAK_PLAYER_PASSWORD'); do
    case "$(env_get "$key")" in
      "" | live | change-me | change-me-*) weak="$weak $key" ;;
    esac
  done
  [ "$(mode)" = standalone ] && return 0 # its database is reached from inside the container only
  if [ -n "$weak" ]; then
    warn "default or missing passwords in $ENV_FILE:$weak — set secrets of your own."
    [ "$(mode)" = full ] && warn "  the Keycloak admin console is reachable from the network."
    return 0
  else
    info "passwords in $ENV_FILE: none left to a default"
  fi
}

# Brings the deployment files of a mode to a release's. Offline (an air-gapped
# host), the files in place are kept.
refresh_files() { # refresh_files <mode> <image tag>
  base="$(files_url "$2")"
  for pair in $(deployment_files "$1"); do
    fetch_file "$base" "${pair%%:*}" "${pair#*:}" || {
      warn "could not download ${pair%%:*} from $base: the file in place is kept."
      return 0
    }
  done
}

need_init() {
  [ -f "$ENV_FILE" ] || die "no $ENV_FILE here — run \`$0 init\` first (or cd to your QuizDock directory)."
  if [ "$(mode)" = compose ] || [ "$(mode)" = full ]; then
    [ -f "$COMPOSE_FILE" ] || die "$COMPOSE_FILE not found — run \`$0 init\` again."
  fi
  if [ "$(mode)" = full ]; then
    [ -f docker-compose.full.yml ] || die "docker-compose.full.yml not found — run init --full again."
    [ -f keycloak/realm-export.json ] || die "keycloak/realm-export.json not found — run \`$0 init --full\` again."
  fi
}

compose() {
  if [ "$(mode)" = full ]; then docker compose -f "$COMPOSE_FILE" -f docker-compose.full.yml --profile keycloak "$@"
  else docker compose -f "$COMPOSE_FILE" "$@"; fi
}

# Runs the in-image admin CLI with the instance's environment; with a terminal
# when there is one, so that an operation can ask for its confirmation.
admin() {
  if [ -t 0 ] && [ -t 1 ]; then tty=1; else tty=; fi
  case "$(mode)" in
    compose | full)
      if [ -n "$tty" ]; then compose exec quizdock qd "$@"
      else compose exec -T quizdock qd "$@"; fi ;;
    standalone)
      if [ -n "$tty" ]; then docker exec -it "$CONTAINER" qd "$@"
      else docker exec -i "$CONTAINER" qd "$@"; fi ;;
  esac
}

confirm() {
  printf '%s [y/N] ' "$1"
  read -r answer
  case "$answer" in y | Y | yes | YES) ;; *) die "aborted." ;; esac
}

ask() { # ask VAR "prompt" "default"
  printf '%s [%s]: ' "$2" "$3"
  read -r reply
  eval "$1=\"\${reply:-$3}\""
}

random_secret() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 16
  else head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'; fi
}

wait_healthy() { # wait_healthy <url> <seconds>
  url="$1"; budget="${2:-90}"; elapsed=0
  while [ "$elapsed" -lt "$budget" ]; do
    if curl -fs "$url" >/dev/null 2>&1; then return 0; fi
    sleep 3; elapsed=$((elapsed + 3))
  done
  return 1
}

# --- commands --------------------------------------------------------------

cmd_init() {
  need_docker
  want_mode=compose
  for a in "$@"; do
    case "$a" in
      --standalone) want_mode=standalone ;;
      --compose) want_mode=compose ;;
      --full) want_mode=full ;;
      *) die "unknown option $a (init [--compose|--full|--standalone])" ;;
    esac
  done
  if [ -f "$ENV_FILE" ]; then
    warn "$ENV_FILE already exists."
    confirm "Overwrite it?"
  fi
  info "QuizDock setup ($want_mode mode)"
  ask app_name "Application name" "QuizDock"
  ask app_lang "Instance language (en, fr, es, zh, zh-TW, tr)" "en"
  ask port "HTTP port on this host" "18080"
  if [ "$want_mode" = full ]; then
    auth_mode=oidc
    ask public_host "Public hostname or LAN IP (used by browsers)" "localhost"
    ask keycloak_port "Keycloak HTTP port on this host" "18081"
  else
    ask auth_mode "Auth mode: none (local host seat) or oidc" "none"
  fi
  case "$auth_mode" in none | oidc) ;; *) die "AUTH_MODE must be none or oidc" ;; esac
  issuer=""; client_id="quiz-dock-frontend"
  if [ "$auth_mode" = oidc ] && [ "$want_mode" != full ]; then
    ask issuer "OIDC issuer (exact \`iss\` of your tokens)" ""
    ask client_id "OIDC client id" "quiz-dock-frontend"
  fi

  # The web administration starts read-only (ADMIN_WEB_SCOPE=read): the choice is made here, once.
  ask web_changes "Let administrators change settings from the browser? (y/N)" "N"
  case "$web_changes" in y | Y | yes | YES) web_scope=write ;; *) web_scope=read ;; esac
  admin_token=""
  # Local mode has no accounts: a change from the web also needs this token.
  if [ "$web_scope" = write ] && [ "$auth_mode" = none ]; then admin_token="$(random_secret)"; fi

  {
    say "# QuizDock — generated by \`quizdock init\` on $(date +%F). Edit freely."
    say "QUIZDOCK_MODE=$want_mode"
    say "QUIZDOCK_TAG=latest"
    say "HTTP_PORT=$port"
    say "APP_NAME=$app_name"
    say "APP_LANG=$app_lang"
    say "AUTH_MODE=$auth_mode"
    if [ "$want_mode" = full ]; then
      say "# One public host for QuizDock and Keycloak; use the same name on each browser."
      say "PUBLIC_HOST=$public_host"
      say "PUBLIC_SCHEME=http"
      say "KEYCLOAK_PORT=$keycloak_port"
      say "KEYCLOAK_ADMIN=admin"
      say "KEYCLOAK_ADMIN_PASSWORD=$(random_secret)"
      say "KEYCLOAK_HOST_PASSWORD=$(random_secret)"
      say "KEYCLOAK_PLAYER_PASSWORD=$(random_secret)"
    fi
    say "# OIDC (used when AUTH_MODE=oidc). Any OpenID Connect provider."
    say "OIDC_ISSUER=$issuer"
    say "OIDC_CLIENT_ID=$client_id"
    say "# Secret of a confidential client; empty = public client (PKCE)."
    say "OIDC_CLIENT_SECRET="
    say "# How the backend reaches the provider, when not at the issuer's address."
    if [ "$want_mode" = full ]; then say "OIDC_INTERNAL_URL=http://keycloak:8080"
    else say "OIDC_INTERNAL_URL="; fi
    say "OIDC_AUDIENCE="
    if [ "$want_mode" = full ]; then say "OIDC_ROLES_CLAIM=realm_access.roles"
    else say "OIDC_ROLES_CLAIM=roles"; fi
    say "OIDC_NAME_CLAIM="
    say "# Proxies allowed to speak for the client (X-Forwarded-*); empty = private addresses."
    say "TRUST_PROXY="
    say "# true = hosts may open a game to participants without an account (PIN + nickname)."
    if [ "$want_mode" = full ]; then say "ALLOW_ANONYMOUS_PARTICIPANTS=true"
    else say "ALLOW_ANONYMOUS_PARTICIPANTS=false"; fi
    say "MEDIA_MAX_BYTES=10485760"
    say "# What the web administration may change: read (nothing) or write (settings C2 to C4, roles)."
    say "ADMIN_WEB_SCOPE=$web_scope"
    if [ -n "$admin_token" ]; then
      say "# Local mode: the token the web administration asks for before any change."
      say "ADMIN_TOKEN=$admin_token"
    fi
    if [ "$want_mode" != standalone ]; then
      say "# Bundled PostgreSQL (compose mode)."
      say "POSTGRES_USER=quizdock"
      say "POSTGRES_PASSWORD=$(random_secret)"
      say "POSTGRES_DB=quizdock"
    fi
  } >"$ENV_FILE"
  chmod 600 "$ENV_FILE"
  info "wrote $ENV_FILE"

  # The files of the release installed (the latest), not of the repository's main branch.
  if [ "$want_mode" != standalone ]; then
    base="$(files_url latest)"
    for pair in $(deployment_files "$want_mode"); do
      info "fetching ${pair#*:}"
      fetch_file "$base" "${pair%%:*}" "${pair#*:}" || die "could not download ${pair%%:*} from $base"
    done
  fi
  say
  if [ -n "$admin_token" ]; then
    say "The administration token (ADMIN_TOKEN) is in $ENV_FILE: give it to the administrators."
  fi
  if [ "$want_mode" = full ]; then
    say "Temporary passwords for host, player and admin are in $ENV_FILE (mode 600)."
    say "Next: $0 up    (then open http://$public_host:$port)"
  else
    say "Next: $0 up    (then open http://localhost:$port)"
  fi
}

cmd_up() {
  need_docker; need_init
  case "$(mode)" in
    compose | full)
      info "starting the stack ($COMPOSE_FILE, tag $(tag))"
      compose up -d
      ;;
    standalone)
      if docker ps -a --format '{{.Names}}' | grep -qx "$CONTAINER"; then
        info "starting container $CONTAINER"
        docker start "$CONTAINER" >/dev/null
      else
        info "creating container $CONTAINER (image $(standalone_image))"
        docker run -d --name "$CONTAINER" --restart unless-stopped \
          -p "$(http_port):3000" -v quizdock:/data --env-file "$ENV_FILE" \
          "$(standalone_image)" >/dev/null
      fi
      ;;
  esac
  info "waiting for the app…"
  if wait_healthy "http://localhost:$(http_port)/health" 120; then
    if [ "$(mode)" = full ]; then
      info "waiting for Keycloak…"
      wait_healthy "http://localhost:$(env_get KEYCLOAK_PORT 18081)/realms/quiz-dock/.well-known/openid-configuration" 180 \
        || die "Keycloak is not ready — check \`$0 logs keycloak\`."
    fi
    info "QuizDock is up: http://localhost:$(http_port)"
  else
    warn "the app is not healthy yet — check \`$0 logs\`."
    exit 1
  fi
}

cmd_down() {
  need_docker; need_init
  case "$(mode)" in
    compose | full) compose down ;;
    standalone) docker stop "$CONTAINER" >/dev/null && info "stopped $CONTAINER" ;;
  esac
}

cmd_status() {
  need_docker; need_init
  case "$(mode)" in
    compose | full) compose ps ;;
    standalone) docker ps -a --filter "name=^${CONTAINER}$" ;;
  esac
  if curl -fs "http://localhost:$(http_port)/health" >/dev/null 2>&1; then
    info "health: ok (http://localhost:$(http_port))"
    # The version it runs, and the latest stable release (UPDATE_CHECK); an image
    # older than this script has no `version`: nothing said.
    admin version 2>/dev/null || true
  else
    warn "health: not responding on port $(http_port)"
  fi
}

cmd_logs() {
  need_docker; need_init
  case "$(mode)" in
    compose | full) compose logs -f --tail=200 "$@" ;;
    standalone) docker logs -f --tail=200 "$CONTAINER" ;;
  esac
}

cmd_backup() {
  need_docker; need_init
  umask 077
  dir="${1:-$BACKUP_ROOT/quizdock-$(date +%Y%m%d-%H%M%S)}"
  mkdir -p "$dir"
  info "backing up to $dir"
  case "$(mode)" in
    compose | full)
      user="$(env_get POSTGRES_USER live)"; db="$(env_get POSTGRES_DB quizdock)"
      compose exec -T postgres pg_dump -U "$user" --clean --if-exists "$db" >"$dir/database.sql"
      if [ "$(mode)" = full ]; then
        compose exec -T postgres pg_dump -U "$user" --clean --if-exists keycloak >"$dir/keycloak.sql"
      fi
      # `docker cp` needs no tar inside the (distroless) app container.
      compose cp quizdock:/data/media "$dir/media" 2>/dev/null || mkdir -p "$dir/media"
      # Shared templates live on their own volume too (#39), not in PostgreSQL.
      compose cp quizdock:/data/store "$dir/store" 2>/dev/null || mkdir -p "$dir/store"
      ;;
    standalone)
      docker exec -i "$CONTAINER" pg_dump -h 127.0.0.1 -U quizdock --clean --if-exists quizdock >"$dir/database.sql"
      docker cp "$CONTAINER:/data/media" "$dir/media" 2>/dev/null || mkdir -p "$dir/media"
      docker cp "$CONTAINER:/data/store" "$dir/store" 2>/dev/null || mkdir -p "$dir/store"
      ;;
  esac
  cp "$ENV_FILE" "$dir/env" && chmod 600 "$dir/env"
  info "done: $(du -sh "$dir" | cut -f1) — database.sql, media/, store/, env$( [ "$(mode)" = full ] && printf ', keycloak.sql' )"
}

cmd_restore() {
  need_docker; need_init
  dir="${1:-}"
  [ -n "$dir" ] && [ -f "$dir/database.sql" ] || die "usage: $0 restore <backup-dir> (a directory written by \`$0 backup\`)"
  if [ "$(mode)" = full ] && [ ! -f "$dir/keycloak.sql" ]; then
    die "full mode restore needs $dir/keycloak.sql (accounts and OIDC configuration)."
  fi
  warn "this REPLACES the current database, media and (in full mode) Keycloak data with $dir."
  confirm "Continue?"
  case "$(mode)" in
    compose | full)
      user="$(env_get POSTGRES_USER live)"; db="$(env_get POSTGRES_DB quizdock)"
      info "stopping the app"
      compose stop quizdock >/dev/null
      info "restoring the database"
      compose exec -T postgres psql -q -U "$user" -d "$db" <"$dir/database.sql" >/dev/null
      if [ "$(mode)" = full ] && [ -f "$dir/keycloak.sql" ]; then
        compose stop keycloak >/dev/null
        compose exec -T postgres psql -q -U "$user" -d keycloak <"$dir/keycloak.sql" >/dev/null
        compose up -d keycloak >/dev/null
      fi
      if [ -d "$dir/media" ]; then
        info "restoring media"
        compose cp "$dir/media/." quizdock:/data/media
      fi
      if [ -d "$dir/store" ]; then
        info "restoring shared templates"
        compose cp "$dir/store/." quizdock:/data/store
      fi
      info "starting the app"
      compose up -d quizdock >/dev/null
      ;;
    standalone)
      info "restoring the database"
      docker exec -i "$CONTAINER" psql -q -h 127.0.0.1 -U quizdock -d quizdock <"$dir/database.sql" >/dev/null
      if [ -d "$dir/media" ]; then
        info "restoring media"
        docker cp "$dir/media/." "$CONTAINER:/data/media"
      fi
      if [ -d "$dir/store" ]; then
        info "restoring shared templates"
        docker cp "$dir/store/." "$CONTAINER:/data/store"
      fi
      info "restarting"
      docker restart "$CONTAINER" >/dev/null
      ;;
  esac
  info "restored. Run \`$0 doctor\` to verify."
}

cmd_upgrade() {
  need_docker; need_init
  new_tag="${1:-$(tag)}"
  info "upgrade to $IMAGE:$new_tag (current: $(tag))"
  say "Migrations are applied automatically and cannot be rolled back: a backup is taken first."
  cmd_backup
  if [ "$new_tag" != "$(tag)" ]; then
    # Persist the tag so that later `up` uses it.
    grep -v '^QUIZDOCK_TAG=' "$ENV_FILE" >"$ENV_FILE.tmp" && say "QUIZDOCK_TAG=$new_tag" >>"$ENV_FILE.tmp" && mv "$ENV_FILE.tmp" "$ENV_FILE"
  fi
  case "$(mode)" in
    compose | full)
      # The release's Compose files too: a new image may need what they set
      # (a hardening, a variable, another Keycloak).
      info "deployment files of $new_tag"
      refresh_files "$(mode)" "$new_tag"
      info "pulling"
      compose pull
      info "restarting with migrations"
      compose up -d
      info "migration output:"
      compose logs --no-log-prefix migrate | tail -n 20
      ;;
    standalone)
      info "pulling"
      docker pull "$(standalone_image)"
      info "recreating the container (data stays in the quizdock volume)"
      docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
      cmd_up
      ;;
  esac
  wait_healthy "http://localhost:$(http_port)/health" 120 || warn "app not healthy yet — check \`$0 logs\`."
  info "post-upgrade check"
  admin doctor
}

cmd_help() {
  cat <<EOF
QuizDock operator CLI

Usage: $0 <command> [args]

Install & run
  init [--compose|--full|--standalone]
                        Create $ENV_FILE (guided) and fetch the Compose/realm files
  up                    Start (compose stack or standalone container), wait for health
  down                  Stop
  status                Containers + health + version
  logs [service]        Follow logs

Maintenance
  backup [dir]          Database dump + media + env → $BACKUP_ROOT/quizdock-<date>/
  restore <dir>         Replace database + media from a backup (asks confirmation)
  upgrade [tag]         backup → pull → restart (migrations) → doctor

Administration (relayed to the CLI inside the container)
  doctor                Check env, database, migrations, Redis, media, OIDC
  version               The version running, and the latest stable release
  seat:status | seat:release
  user:list | user:set-role <sub|email> host|admin|host,admin|player
  samples:load <sub|email>
  quiz:list [<sub|email>]
  quiz:export <id> <file.zip>       Write a quiz bundle (quiz.json + media/) on the host
  quiz:import <file> <sub|email>    Create a draft from a bundle (zip or quiz.json)
  quiz:validate <file>              Check text-only JSON without writes
  mcp [--user=<sub|email>]           Local MCP on stdin/stdout, experimental (no TTY)
  quiz:transfer <quiz-id> <sub|email>  Hand a quiz over to another account
  sessions:purge [--dry-run]
  qd <operation> [--param=value…] [--yes] [--dry-run] [--json]
                        Any administrative operation (\`qd operations\` lists them)
  admin <command…>      Any other in-image command (\`admin help\`)

Environment: QUIZDOCK_IMAGE, QUIZDOCK_COMPOSE_FILE, QUIZDOCK_ENV_FILE, QUIZDOCK_BACKUP_DIR.
EOF
}

# --- dispatch --------------------------------------------------------------

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
  init) cmd_init "$@" ;;
  up | start) cmd_up ;;
  down | stop) cmd_down ;;
  status | ps) cmd_status ;;
  logs) cmd_logs "$@" ;;
  backup) cmd_backup "$@" ;;
  restore) cmd_restore "$@" ;;
  upgrade) cmd_upgrade "$@" ;;
  doctor)
    need_docker; need_init; check_secrets; admin doctor "$@" ;;
  version | seat:status | seat:release | user:list | user:set-role | samples:load | sessions:purge | migrate:status | quiz:list | quiz:transfer)
    need_docker; need_init; admin "$cmd" "$@" ;;
  quiz:export)
    [ $# -eq 2 ] || die "usage: $0 quiz:export <id> <file.zip>"
    need_docker; need_init
    admin quiz:export "$1" - >"$2" || { rm -f "$2"; exit 1; }
    echo "Exported quiz $1 to $2." ;;
  quiz:import)
    [ $# -eq 2 ] || die "usage: $0 quiz:import <file> <sub|email>"
    [ -f "$1" ] || die "no such file: $1"
    need_docker; need_init; admin quiz:import - "$2" <"$1" ;;
  quiz:validate)
    [ $# -eq 1 ] || die "usage: $0 quiz:validate <file>"
    [ -f "$1" ] || die "no such file: $1"
    need_docker; need_init; admin quiz:validate - <"$1" ;;
  mcp) need_docker; need_init; admin mcp "$@" ;;
  admin | qd) need_docker; need_init; admin "$@" ;;
