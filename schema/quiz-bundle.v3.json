{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/quizdock/quiz-dock/main/schema/quiz-bundle.v3.json",
  "title": "QuizDock quiz bundle manifest (quizdock/quiz), version 3",
  "description": "quiz.json at the root of a QuizDock bundle, next to its media/ folder. Structural rules only; see docs/quiz-bundle.md.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "quizdock/quiz"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "quiz": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 200,
          "pattern": "\\S"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "language": {
          "type": "string",
          "minLength": 2,
          "maxLength": 10
        },
        "feedbackEnabled": {
          "type": "boolean"
        },
        "mediaTailS": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "loudnessTargetLufs": {
          "anyOf": [
            {
              "type": "number",
              "const": -14
            },
            {
              "type": "number",
              "const": -16
            },
            {
              "type": "number",
              "const": -23
            }
          ]
        },
        "audioTarget": {
          "type": "string",
          "enum": [
            "projection",
            "projection_remote",
            "everyone"
          ]
        },
        "cover": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "slug": {
          "type": "string",
          "maxLength": 60,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "namespace": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "domain": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 50
            },
            {
              "type": "null"
            }
          ]
        },
        "tags": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 30,
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          }
        },
        "license": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9.+-]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "media": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "alt": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "credit": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "durationMs": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "peaks": {
            "minItems": 200,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "origin": {
            "type": "string",
            "enum": [
              "upload",
              "recording"
            ]
          },
          "loudnessLufs": {
            "type": "number",
            "minimum": -70,
            "maximum": 0
          },
          "peakDbfs": {
            "type": "number",
            "minimum": -100,
            "maximum": 6
          }
        }
      }
    },
    "items": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "question"
              },
              "type": {
                "type": "string",
                "enum": [
                  "single_choice",
                  "multiple_choice",
                  "true_false",
                  "text_input",
                  "numeric",
                  "ordering",
                  "poll"
                ]
              },
              "prompt": {
                "type": "string"
              },
              "media": {
                "type": "string",
                "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
              },
              "audio": {
                "type": "string",
                "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
              },
              "answerExplanation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backgroundImage": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backgroundGradient": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "angle": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "colors": {
                        "minItems": 2,
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        }
                      }
                    },
                    "required": [
                      "angle",
                      "colors"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "textTone": {
                "type": "string",
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "textOutline": {
                "type": "boolean"
              },
              "timeLimitS": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "revealDelayS": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "audioTarget": {
                "type": "string",
                "enum": [
                  "projection",
                  "projection_remote",
                  "everyone"
                ]
              },
              "waveformSize": {
                "type": "string",
                "enum": [
                  "S",
                  "M",
                  "L"
                ]
              },
              "timerAfterMedia": {
                "type": "boolean"
              },
              "pointsMode": {
                "type": "string",
                "enum": [
                  "standard",
                  "double",
                  "none",
                  "fixed"
                ]
              },
              "scoring": {
                "type": "string",
                "enum": [
                  "standard",
                  "closest",
                  "partial",
                  "lenient"
                ]
              },
              "numericValue": {
                "type": "number"
              },
              "numericTolerance": {
                "type": "number"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string"
                    },
                    "media": {
                      "type": "string",
                      "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
                    },
                    "color": {
                      "type": "string"
                    },
                    "shape": {
                      "type": "string"
                    },
                    "isCorrect": {
                      "type": "boolean"
                    },
                    "correctOrderIndex": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "color",
                    "shape"
                  ]
                }
              },
              "acceptedAnswers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "kind",
              "type",
              "prompt"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "slide"
              },
              "blocks": {
                "type": "array",
                "items": {}
              },
              "backgroundImage": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^media\\/[A-Za-z0-9][A-Za-z0-9._-]{0,120}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "backgroundGradient": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "angle": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 360
                      },
                      "colors": {
                        "minItems": 2,
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "pattern": "^#[0-9a-fA-F]{6}$"
                        }
                      }
                    },
                    "required": [
                      "angle",
                      "colors"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "textTone": {
                "type": "string",
                "enum": [
                  "light",
                  "dark"
                ]
              },
              "textOutline": {
                "type": "boolean"
              },
              "displayDelayS": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "kind"
            ]
          }
        ]
      }
    }
  },
  "required": [
    "format",
    "quiz",
    "items"
  ]
}
