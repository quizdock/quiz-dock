# Development stack (docker-compose.yml + override): copy to `.env` and adjust.
# Never commit the real `.env`.
# Deploying QuizDock? Start from env/standalone.env.example, env/local.env.example
# or env/oidc.env.example instead; env/full.env.example bundles Keycloak.
#
# Generated from the settings registry (pnpm generate:settings-docs): edit
# packages/contracts/src/admin/settings.ts, not this file. Every variable is
# described in docs/self-hosting/configuration.md.

# ── Identity & branding ───────────────────────────────────────────────────────

# Brand name shown in the header, tab title and share text. Accepts 1 to 40
# characters.
APP_NAME=QuizDock

# UI language for the instance. One per deployment (no browser detection). New
# quizzes start in this language; each quiz can be set to another in its
# settings. Accepts en · fr · es · zh · zh-TW · tr.
APP_LANG=en

# Logo served from somewhere else (a CDN, a path outside branding/). Empty by
# default, which is the usual setup: the logo is then looked up in the mounted
# branding/ folder. Accepts an https:// URL.
# APP_LOGO_URL=

# Where the home page's Report a bug · Suggest a feature · Fix a translation ·
# Ask a question links lead. Empty: the QuizDock repository, its forms filled
# in with the version, the browser and the language. Another GitHub repository
# (https://github.com/owner/repo): the same forms there — copy
# .github/ISSUE_TEMPLATE/ into it. Any other address: a single Send feedback
# link. none: no links. Accepts an http(s):// URL, or none.
# APP_FEEDBACK_URL=

# ── Access & authentication (OIDC_* used only with AUTH_MODE=oidc) ────────────

# none = local mode (no IdP, single host seat); oidc = sign-in with any OpenID
# Connect provider, the session held by the backend. Accepts none · oidc.
AUTH_MODE=none

# true = public demo guards: the host seat lasts 5 min (renewable), media
# uploads are refused, and everything is wiped every hour. Accepts true ·
# false.
DEMO_MODE=false

# AUTH_MODE=oidc only: true lets hosts open a game to participants without an
# account, the PIN and a nickname alone — chosen at each launch. Accepts true
# · false.
ALLOW_ANONYMOUS_PARTICIPANTS=false

# iss expected in tokens (your provider's issuer URL). Required when
# AUTH_MODE=oidc. Accepts an http(s):// URL, without query or fragment.
OIDC_ISSUER=http://localhost:18080/realms/quiz-dock

# The client registered with your provider.
OIDC_CLIENT_ID=quiz-dock-frontend

# Its secret, for a confidential client. Unset: a public client, protected by
# PKCE.
OIDC_CLIENT_SECRET=

# Where the backend reaches the provider when the browser's address is not
# reachable from its network (Docker): discovery, tokens and keys go through
# it. Defaults to the host of OIDC_JWKS_URI when that one points elsewhere
# than the issuer. Accepts an http(s):// URL.
OIDC_INTERNAL_URL=http://keycloak:8080

# Key endpoint, when discovery's must not be used. Accepts an http(s):// URL.
# OIDC_JWKS_URI=

# Expected aud. Left unset = audience check skipped.
OIDC_AUDIENCE=

# Dotted path to the roles array in the JWT (e.g. groups, realm_access.roles).
# A typo locks every administrator out. Accepts a dotted path.
OIDC_ROLES_CLAIM=realm_access.roles

# Dotted path to the display-name claim (e.g. the standard nickname). Unset,
# or absent from a token: preferred_username, then name, then email. Accepts a
# dotted path.
OIDC_NAME_CLAIM=

# ── Network & invitation ──────────────────────────────────────────────────────

# Which hops may speak for the client through X-Forwarded-For /
# X-Forwarded-Proto (client address of the wrong-PIN limit, Secure session
# cookie). Default: a peer on a private address. Accepts false, true, a number
# of proxies, or addresses and CIDR ranges.
# TRUST_PROXY=

# Public address of the instance. Offered first as the invitation address (QR
# code, join link) on the host console. Accepts an http(s):// URL, without
# path.
# APP_PUBLIC_URL=https://quiz.example.org

# Comma-separated LAN IPs of the machine (bare IPs), for setups where the
# container cannot see the host's interfaces (Docker Desktop, bridge network).
# Offered as invitation addresses with the scheme and port of the page.
# Accepts comma-separated IPv4 addresses.
# HOST_LAN_IPS=192.168.1.103

# Comma-separated registry URLs of the community catalogue. Leave unset or
# empty to hide the community page and prevent all outgoing store requests.
# Enabling contacts the listed services from the server: its IP is visible, no
# user data is sent. Accepts up to five comma-separated http(s):// URLs.
# QUIZ_STORE_URL=https://raw.githubusercontent.com/quizdock/quiz-store/main/registry.json

# Additional exact host names allowed for source indexes, artifacts and
# redirects. Registry hosts are allowed automatically. Empty: the registry
# hosts only. Accepts comma-separated host names.
# QUIZ_STORE_HOSTS=github.com,release-assets.githubusercontent.com

# ── Limits ────────────────────────────────────────────────────────────────────

# Max size of an uploaded image, in bytes. Default 10 MiB. Accepts bytes, 1 to
# 50 MB.
MEDIA_MAX_BYTES=10485760

# Max size of an uploaded video, in MB. The editor converts to MP4 H.264 + AAC
# and compresses a long video to fit. Accepts 1 to 500 (MB).
MEDIA_MAX_VIDEO_MB=50

# Max size of an uploaded sound, in MB. The editor converts to M4A (AAC).
# Accepts 1 to 100 (MB).
MEDIA_MAX_AUDIO_MB=10

# Max size of an imported quiz bundle (zip), in bytes. Default 50 MiB. Accepts
# bytes, 1 to 500 MB.
IMPORT_MAX_BYTES=52428800

# Largest bundle the editor's Export for publication allows, in MB: the limit
# of the community store, kept under GitHub's 25 MB web-upload limit. An
# organisation running its own store may set another. Accepts 1 to 100 (MB).
# PUBLICATION_MAX_MB=20

# The free media libraries the editor links to: a JSON list of {"name", "url",
# "kinds"} (kinds among image, video, audio), or none to hide them (an
# instance without Internet). Default, open licences only and several per
# kind: OpenSoundLibrary, Freesound, ccMixter, Openverse, Wikimedia Commons,
# NASA Image and Video Library, Internet Archive. Accepts a JSON list, or
# none.
# MEDIA_LIBRARY_LINKS=

# ── Game pace ─────────────────────────────────────────────────────────────────

# Reading window shown before a question's timer starts, in milliseconds.
# Accepts 0 to 10000 (ms).
# GAME_READ_DELAY_MS=3000

# Once every participant has answered, how long the question stays before its
# answer is revealed, in milliseconds. Accepts 0 to 5000 (ms).
# GAME_ALL_ANSWERED_DELAY_MS=1000

# Automatic mode: time spent on a reveal or a content slide before moving on,
# unless the question or slide sets its own, in milliseconds. Accepts 1000 to
# 60000 (ms).
# GAME_AUTO_ADVANCE_MS=5000

# How long the room waits at most, before a question, for the devices that
# play its sound or video to load it (the host can start anyway), in seconds.
# 0 never waits. Accepts 0 to 60 (s).
# GAME_MEDIA_WAIT_S=10

# Transitions between steps on the projection and the phones, as a new room
# starts: the previous background fades out, the step comes in, the standings
# slide. off for old projectors or low-end devices. The host switches it for
# their room at any time (console, Animations); a device asking the system to
# reduce motion keeps fades only. Accepts on · off.
# LIVE_MOTION=on

# ── Development stack: host ports ─────────────────────────────────────────────

# Host port of the dev backend.
BACKEND_PORT=13000

# Host port of the built frontend.
FRONTEND_PORT=18081

# Host port of the Vite dev server.
VITE_PORT=15173

# Host port of the dev database.
POSTGRES_PORT=15432

# Host port of the dev Redis.
REDIS_PORT=16379

# ── Bundled PostgreSQL ────────────────────────────────────────────────────────

# Bundled PostgreSQL user (builds DATABASE_URL).
POSTGRES_USER=live

# Its password.
POSTGRES_PASSWORD=live

# Its database.
POSTGRES_DB=quizdock

# ── Example OIDC provider (Keycloak, started with --profile keycloak) ─────────

# Keycloak's published HTTP port.
KEYCLOAK_PORT=18080

# Full preset: override the browser-facing Keycloak URL, including a proxy
# path.
# KEYCLOAK_PUBLIC_URL=

# Override the app URL allowed for browser redirects. Dev also allows
# localhost:15173, and defaults to localhost:18081.
# KEYCLOAK_APP_URL=

# Additional dev frontend redirect, alongside KEYCLOAK_APP_URL. The full
# preset uses only KEYCLOAK_APP_URL.
# KEYCLOAK_DEV_URL=

# Keycloak bootstrap administrator.
KEYCLOAK_ADMIN=admin

# Bootstrap administrator password; replace the manual example before first
# start.
KEYCLOAK_ADMIN_PASSWORD=admin

# Initial temporary full-preset host password; dev always uses animateur.
# KEYCLOAK_HOST_PASSWORD=

# Initial temporary full-preset player password; dev always uses participant.
# KEYCLOAK_PLAYER_PASSWORD=
