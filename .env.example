# Development stack (docker-compose.yml + override): copy to `.env` and adjust.
# Never commit the real `.env`.
# Deploying QuizDock? Start from env/standalone.env.example, env/local.env.example
# or env/oidc.env.example instead.

# --- Marque (white-label) ---
# Nom d'app affiché (header, onglet, partage). Surchargé au runtime sans rebuild.
# Logo + CSS d'override : voir le dossier `branding/` (monté en volume).
APP_NAME=QuizDock
# Langue de l'UI pour cette instance (une seule par déploiement, pas de détection
# navigateur). Valeurs : en (défaut) | fr | es | zh (chinois simplifié) | zh-TW
# (chinois traditionnel).
APP_LANG=en
# Logo servi depuis une autre adresse (CDN, chemin hors `branding/`). Vide par défaut :
# le logo est alors cherché dans le dossier `branding/` monté (logo.svg, .avif, .webp,
# .png, .jpg, .jpeg, .gif — le premier trouvé gagne), sinon celui livré avec l'image.
# APP_LOGO_URL=
# Liens « signaler un bug / proposer une idée… » de l'accueil : vide = dépôt QuizDock,
# une URL = votre dépôt (GitHub pour des formulaires pré-remplis), none = masqués.
# APP_FEEDBACK_URL=

# --- Auth ---
# none = mode local sans IdP (dev, réseau de confiance) | oidc = validation JWT d'un fournisseur OIDC
AUTH_MODE=none
# --- Démo publique (indépendant de AUTH_MODE) ---
# true = garde-fous d'une instance ouverte à tous : siège d'hôte de 5 min
# (renouvelable), upload de médias refusé, remise à zéro toutes les heures.
DEMO_MODE=false

# --- OIDC (utilisé seulement si AUTH_MODE=oidc) ---
# N'importe quel fournisseur OpenID Connect (rien de spécifique à un produit).
# Le backend mène la connexion (Authorization Code + PKCE) et garde les jetons ;
# le navigateur n'a qu'un cookie de session.
# OIDC_ISSUER = `iss` attendu dans les jetons (tel que vu par le navigateur).
# OIDC_INTERNAL_URL : adresse par laquelle le backend joint l'IdP quand ce n'est
# pas celle du navigateur (réseau Docker interne) ; discovery, jetons et JWKS y passent.
OIDC_ISSUER=http://localhost:18080/realms/quiz-dock
OIDC_INTERNAL_URL=http://keycloak:8080
# client_id du client enregistré chez l'IdP ; client public (PKCE) sans secret,
# confidentiel avec OIDC_CLIENT_SECRET.
OIDC_CLIENT_ID=quiz-dock-frontend
OIDC_CLIENT_SECRET=
# Optionnels : audience attendue (`aud`), chemin pointé du claim de rôles
# (défaut `roles` ; l'IdP d'exemple ci-dessous les expose sous `realm_access.roles`),
# et chemin pointé du claim de nom affiché (défaut : `preferred_username`, `name`, `email`).
OIDC_AUDIENCE=
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_NAME_CLAIM=
# `true` : l'hôte peut ouvrir une partie aux participants sans compte (PIN + pseudo),
# au choix à chaque lancement. Sans effet hors AUTH_MODE=oidc.
ALLOW_ANONYMOUS_PARTICIPANTS=false

# --- Ports exposés (hôte) — peu courants pour éviter les collisions ---
# Mnémo : « 4 » + le port usuel. Ports internes des conteneurs inchangés.
BACKEND_PORT=13000
FRONTEND_PORT=18081
VITE_PORT=15173
POSTGRES_PORT=15432
REDIS_PORT=16379
KEYCLOAK_PORT=18080

# --- PostgreSQL ---
POSTGRES_USER=live
POSTGRES_PASSWORD=live
POSTGRES_DB=quizdock

# --- Médias (volume local servi par le backend) ---
# Taille maximale d'une image uploadée (octets). Défaut 10 Mio.
MEDIA_MAX_BYTES=10485760
# Taille maximale d'une vidéo MP4 (H.264) et d'un son MP3, en Mo. Défauts 50 et 10.
# Derrière un reverse proxy, sa limite de corps de requête doit suivre (nginx : client_max_body_size).
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_AUDIO_MB=10

# --- Adresse des invitations (QR code, lien « rejoindre ») ---
# Adresse publique de l'instance, proposée en premier sur la console (déploiement réel).
# APP_PUBLIC_URL=https://quiz.example.org
# Instance locale : IP LAN de la machine si le conteneur ne voit pas ses interfaces
# (Docker Desktop). L'animateur peut toujours saisir une adresse dans la console.
# HOST_LAN_IPS=192.168.1.103
# Taille max d'un bundle de quiz importé (zip quiz.json + media/), défaut 50 Mio.
IMPORT_MAX_BYTES=52428800

# --- IdP OIDC d'exemple pour le dev (Keycloak, démarré avec --profile keycloak) ---
# Simple exemple : n'importe quel fournisseur OIDC fait l'affaire en ajustant OIDC_*.
# Identifiants admin de sa console.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ── Live engine tuning (ms) ──────────────────────────────────────────────────
# Automatic mode: time on a reveal / content slide before moving on (per-question
# and per-slide values override it). Reading window before a question's timer.
# GAME_AUTO_ADVANCE_MS=5000
# GAME_READ_DELAY_MS=3000
# Max wait before a question for the devices that play its sound or video (0 = never wait)
# GAME_MEDIA_WAIT_S=10
