# QuizDock — Docker Compose with your identity provider (OIDC): as many hosts as you
# like, each signing in with their own account.
#
#   curl -O https://raw.githubusercontent.com/quizdock/quiz-dock/main/docker-compose.prod.yml
#   cp env/oidc.env.example .env       # next to docker-compose.prod.yml
#   docker compose -f docker-compose.prod.yml up -d
#
# Any OpenID Connect provider: Keycloak, Authentik, Entra ID, Google… Register a
# public client (Authorization Code + PKCE) for the address players and hosts open:
# redirect URI https://<your instance>/auth/callback, post-logout redirect and web
# origin https://<your instance>. Walk-through: docs/self-hosting/auth.md
# The same settings work with `:standalone` (drop the database section).

# --- Image and port ---
QUIZDOCK_TAG=latest
HTTP_PORT=18080

# --- Database (the bundled PostgreSQL) ---
POSTGRES_USER=quizdock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quizdock

# --- Your instance ---
APP_NAME=QuizDock
APP_LANG=en
# The address players type or scan (QR code, join link).
APP_PUBLIC_URL=https://quiz.example.org

# --- Identity provider ---
AUTH_MODE=oidc
# The issuer exactly as it appears in the tokens (`iss`), as the browser sees it.
OIDC_ISSUER=https://sso.example.org/realms/quizdock
# The public client registered for QuizDock.
OIDC_CLIENT_ID=quizdock
# Where the roles are in the token (dotted path) — the account needs `host` to present,
# `admin` to manage the instance. Keycloak: realm_access.roles.
OIDC_ROLES_CLAIM=roles
# Optional: the audience the tokens must carry, the claim the displayed name comes
# from (default: preferred_username, then name, then email), and the key endpoint
# when the backend reaches the provider by another address than the browser.
# OIDC_AUDIENCE=
# OIDC_NAME_CLAIM=
# OIDC_JWKS_URI=

# --- Players ---
# false = every player signs in with an account. true = a host may also open a game
# to anyone with the PIN and a nickname, chosen at each launch.
ALLOW_ANONYMOUS_PARTICIPANTS=false
# browser = one sign-in for all the host's tabs (console, projection, preview);
# tab = each tab signs in on its own, for shared computers.
OIDC_SESSION_SCOPE=browser

# --- Branding and media (optional) ---
# APP_LOGO_URL=
# APP_FEEDBACK_URL=
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_AUDIO_MB=10
IMPORT_MAX_BYTES=52428800
# MEDIA_LIBRARY_LINKS=none
