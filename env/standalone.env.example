# QuizDock — one container (`:standalone`): the app, PostgreSQL and Redis in one image.
#
#   cp env/standalone.env.example .env
#   docker run -d -p 18080:3000 -v quizdock:/data --env-file .env fchaussin/quizdock:standalone
#   → http://localhost:18080
#
# The database and the cache live inside the container, on the `quizdock` volume:
# nothing to set for them. Local mode: one host at a time signs in with a name.
# Every variable: docs/self-hosting/configuration.md

# --- Your instance ---
APP_NAME=QuizDock
# Interface language, one per instance: en | fr | es | zh | zh-TW
APP_LANG=en
# The address players type or scan (QR code, join link). Leave empty to pick it
# in the console; set it once the instance has a public address.
# APP_PUBLIC_URL=https://quiz.example.org
# On a laptop (Docker Desktop), the machine's LAN address, offered in the console.
# HOST_LAN_IPS=192.168.1.20

# --- Branding (optional) ---
# A logo served from elsewhere; empty = the mounted `branding/` folder, else the default.
# APP_LOGO_URL=
# Where the home page's "report a bug / suggest a feature" links lead:
# empty = the QuizDock repository, a URL = yours, none = hidden.
# APP_FEEDBACK_URL=

# --- Who hosts ---
# none = local mode (a name takes the host seat); oidc = your identity provider,
# see env/oidc.env.example for the settings that go with it.
AUTH_MODE=none

# --- Media ---
# Largest image (bytes), video and sound (MB). A reverse proxy in front must accept
# bodies that big too (nginx: client_max_body_size).
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_AUDIO_MB=10
# Largest quiz bundle imported (zip), bytes.
IMPORT_MAX_BYTES=52428800
# Free media libraries the editor links to: a JSON list of {"name","url","kinds"}
# (kinds: image, video, audio), or none for an instance without Internet.
# MEDIA_LIBRARY_LINKS=none
