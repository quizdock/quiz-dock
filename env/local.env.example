# QuizDock — Docker Compose, local mode: the app, PostgreSQL, Redis and the one-shot
# migrations, with one host at a time signing in with a name.
#
#   curl -O https://raw.githubusercontent.com/quizdock/quiz-dock/main/docker-compose.prod.yml
#   cp env/local.env.example .env      # next to docker-compose.prod.yml
#   docker compose -f docker-compose.prod.yml up -d
#   → http://localhost:18080
#
# For a trusted network: a classroom, a meeting room. With an identity provider,
# start from env/oidc.env.example instead. Every variable:
# docs/self-hosting/configuration.md

# --- Image and port ---
# A release (0.7.1…) rather than latest, so an upgrade is a choice: see
# docs/self-hosting/upgrading.md.
QUIZDOCK_TAG=latest
HTTP_PORT=18080

# --- Database (the bundled PostgreSQL) ---
# Change the password: it only ever leaves the compose network in a backup.
POSTGRES_USER=quizdock
POSTGRES_PASSWORD=change-me
POSTGRES_DB=quizdock

# --- Your instance ---
APP_NAME=QuizDock
# Interface language, one per instance: en | fr | es | zh | zh-TW
APP_LANG=en
# The address players type or scan (QR code, join link).
# APP_PUBLIC_URL=https://quiz.example.org
# HOST_LAN_IPS=192.168.1.20

# --- Branding (optional) ---
# APP_LOGO_URL=
# APP_FEEDBACK_URL=

# --- Who hosts ---
AUTH_MODE=none

# --- Media ---
MEDIA_MAX_BYTES=10485760
MEDIA_MAX_VIDEO_MB=50
MEDIA_MAX_AUDIO_MB=10
IMPORT_MAX_BYTES=52428800
# MEDIA_LIBRARY_LINKS=none

# --- A public demo (optional) ---
# true = guards for an instance open to strangers: one shared host account,
# read-only templates, no uploads, everything wiped hourly.
DEMO_MODE=false
