# QuizDock + bundled Keycloak. Copy to .env beside docker-compose.prod.yml,
# then run: docker compose -f docker-compose.prod.yml -f docker-compose.full.yml --profile keycloak up -d
# The quizdock CLI can generate this file with random passwords: ./quizdock init --full

QUIZDOCK_MODE=full
QUIZDOCK_TAG=latest
HTTP_PORT=18080
KEYCLOAK_PORT=18081

# Use one hostname/IP reachable by every browser. Both services use it, on
# separate ports. For public TLS, set PUBLIC_SCHEME=https and proxy both ports.
PUBLIC_HOST=localhost
PUBLIC_SCHEME=http
APP_NAME=QuizDock
APP_LANG=en

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-database
POSTGRES_DB=quizdock
# QuizDock's own role: it owns the database above and nothing else (set before the first start).
QUIZDOCK_DB_USER=quizdock
QUIZDOCK_DB_PASSWORD=change-me-app-db

AUTH_MODE=oidc
OIDC_CLIENT_ID=quiz-dock-frontend
OIDC_INTERNAL_URL=http://keycloak:8080
OIDC_ROLES_CLAIM=realm_access.roles
ALLOW_ANONYMOUS_PARTICIPANTS=true

# Change all four passwords before the first start. The two sample users must
# choose new passwords on their first sign-in; Keycloak imports the realm once.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-admin
KEYCLOAK_HOST_PASSWORD=change-me-host
KEYCLOAK_PLAYER_PASSWORD=change-me-player
# Keycloak's own PostgreSQL role: its database belongs to it (set before the first start).
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Optional overrides for a reverse proxy that changes the public ports/paths:
# APP_PUBLIC_URL=https://quiz.example.org
# KEYCLOAK_PUBLIC_URL=https://id.example.org
# KEYCLOAK_APP_URL=https://quiz.example.org
# OIDC_ISSUER=https://id.example.org/realms/quiz-dock
